# Copy to .env.deploy and fill in secrets before `docker compose --env-file .env.deploy up`.
# Never commit real .env.deploy files.

POSTGRES_USER=hrms
POSTGRES_PASSWORD=replace_with_strong_db_password
POSTGRES_DB=hrms
POSTGRES_PORT=5432

# Browser origin(s) allowed by CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:8080

# Required in production — at least 32 random characters
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Seed demo users on first boot (set false after first deploy)
SEED_ON_START=true

API_PORT=5001
WEB_PORT=8080
