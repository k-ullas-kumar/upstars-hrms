PORT=5001
NODE_ENV=development

# PostgreSQL connection string. Leave empty (or keep a placeholder) to fall back to a local SQLite file.
# Example: postgresql://postgres:yourpassword@localhost:5432/hrms
DATABASE_URL=
# Set to true when your managed Postgres requires SSL
DATABASE_SSL=false
# Used only for the SQLite fallback
SQLITE_PATH=./data/hrms.sqlite

# Required in production (min 32 chars). A dev-only default is used otherwise.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins
FRONTEND_URL=http://localhost:3000

# Where generated PDFs are written
STORAGE_DIR=./uploads
